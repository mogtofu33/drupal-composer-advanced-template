<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="CustomDrupal">
  <description>A custom coding standard to check that Drupal Best practices are followed.</description>

  <arg name="basepath" value="."/>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml"/>
  <arg name="parallel" value="75"/>
  <arg name="colors"/>
  <arg value="p"/>

  <file>./web/modules/custom/</file>
  <file>./web/themes/custom/</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <!--Exclude folders used by common frontend tools. These folders match the file_scan_ignore_directories setting in default.settings.php-->
  <exclude-pattern>*/bower_components/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <!--Exclude third party code.-->
  <exclude-pattern>./web/core/assets/vendor/*</exclude-pattern>
  <!--Exclude the PHPStan baseline from coding standards.-->
  <exclude-pattern>./web/core/.phpstan-baseline.php</exclude-pattern>
  <!-- Exclude third-party code maintained within core that does not follow our standards. -->
  <exclude-pattern>./web/core/lib/Drupal/Component/Diff/</exclude-pattern>
  <exclude-pattern>./web/core/tests/Drupal/Tests/Component/Annotation/Doctrine/</exclude-pattern>
  <!--Exclude test files that are intentionally empty, or intentionally violate coding standards.-->
  <exclude-pattern>./web/core/modules/system/tests/fixtures/HtaccessTest</exclude-pattern>

  <!-- Ignore tests directories -->
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/Tests/*</exclude-pattern>

  <!-- Ignore various version control directories. -->
  <exclude-pattern>*/\.git/*</exclude-pattern>
  <exclude-pattern>*/\.svn/*</exclude-pattern>
  <exclude-pattern>*/\.hg/*</exclude-pattern>
  <exclude-pattern>*/\.bzr/*</exclude-pattern>

  <!-- Ignore custom -->
  <exclude-pattern>scripts/phpunit/*</exclude-pattern>
  <exclude-pattern>scripts/xhprof/*</exclude-pattern>

  <rule ref="Drupal">
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>
    <exclude name="Drupal.Commenting.Deprecated"/>
  </rule>

  <!-- Disable as there is a lot to fix for custom code -->
  <rule ref="Drupal.Arrays.Array.LongLineDeclaration">
    <severity>0</severity>
  </rule>

  <!-- Disable missing class comment with 8.8 upgrade as there is a lot to fix -->
  <rule ref="Drupal.Commenting.ClassComment.Short">
    <severity>0</severity>
  </rule>

  <rule ref="DrupalPractice"/>

  <!--Generic PHP Sniff-->
  <rule ref="Squiz.WhiteSpace.OperatorSpacing" />
  <rule ref="Squiz.PHP.CommentedOutCode" />
  <rule ref="Squiz.PHP.Eval" />
</ruleset>
